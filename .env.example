# Zokul Production Environment Variables
# Copy to .env and fill in your values

JWT_SECRET=change-me-to-a-random-secret
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Database password (internal network only). Postgres applies it when the
# data volume is first created; changing it later needs ALTER USER as well.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
